# --- Serveur ---
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Base de données (Neon) ---
# Connexion directe : utilisée pour les migrations Prisma (local + CI/CD)
DIRECT_DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/longrich?sslmode=require"
# Connexion poolée (pgbouncer) : utilisée par l'application en production
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.neon.tech/longrich?sslmode=require&pgbouncer=true&connection_limit=1"

# --- Auth ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=longrich_token

# --- Reset de mot de passe (nom secret) ---
# Durée de validité de l'accès temporaire après vérification du nom secret (en minutes)
PASSWORD_RESET_SESSION_MINUTES=10

# --- Rate limiting ---
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
SECRET_NAME_RATE_LIMIT_MAX=5
SECRET_NAME_RATE_LIMIT_WINDOW_MINUTES=15

# --- Uploads (images produits, avatars, logo) ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
